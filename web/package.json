{
  "name": "pharmaos-web",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaOS — copiloto de rentabilidad para farmacias (MVP web con datos mock)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:config": "python3 ../stock-profit-os/scripts/export_web_config.py",
    "gen:mock": "cd ../stock-profit-os && python3 -m engine.cli exportar-json --mock --salida ../web/public/mock/report.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "next": "15.5.29",
    "papaparse": "5.7.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.7",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "26.1.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
