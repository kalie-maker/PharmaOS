<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Informe semanal de stock · {{ r.farmacia }}</title>
<style>
{% include "_styles.css.j2" %}
</style>
</head>
<body>
<div class="page">
<header>
  <div>
    <h1>{{ r.farmacia }}</h1>
    <div class="sub">Informe semanal de stock · datos hasta {{ r.periodo.fecha_referencia | fecha }} (ventas desde {{ r.periodo.inicio_ventas | fecha }})</div>
  </div>
  <div class="sub">Stock Profit OS</div>
</header>

{% if r.calidad and r.calidad.nivel != "buena" %}
<div class="banner {{ r.calidad.nivel }}">
  <strong>Calidad de datos {{ r.calidad.nivel }}.</strong> {{ r.calidad.mensaje }}
  <ul>
  {% for c in r.calidad.comprobaciones if c.estado != "ok" %}
    <li>{{ c.descripcion }}: {{ c.afectados | num }} ({{ c.porcentaje | pct }})</li>
  {% endfor %}
  </ul>
</div>
{% endif %}

<section class="kpis">
  <div class="kpi"><div class="v">{{ r.cifras_clave.valor_stock_eur | eur }}</div><div class="l">Stock total a coste</div></div>
  <div class="kpi"><div class="v">{{ r.cifras_clave.sin_movimiento_eur | eur }}</div><div class="l">Inmovilizado sin ventas en {{ r.cifras_clave.sin_movimiento_dias }} días ({{ r.cifras_clave.sin_movimiento_refs | num }} ref.)</div></div>
  <div class="kpi"><div class="v">{{ r.cifras_clave.riesgo_caducidad_eur | eur }}</div><div class="l">En riesgo por caducidad (≤ {{ r.cifras_clave.riesgo_caducidad_dias }} días)</div></div>
</section>
<p class="summary">{{ r.resumen }}</p>

<h2>Acciones de la semana</h2>
{% if r.acciones %}
<ol class="actions">
{% for a in r.acciones %}
  <li>
    <div><div class="t">{{ a.titulo }}</div><div class="e">{{ a.explicacion }}</div></div>
    <div class="imp">{{ a.impact_eur | eur }}<small>Prioridad {{ a.prioridad | lower }}</small></div>
  </li>
{% endfor %}
</ol>
{% else %}
<p>No hay acciones con impacto relevante esta semana.</p>
{% endif %}

<section class="annex">
<h2>Anexo</h2>
{% for a in r.acciones %}
{% if a.references %}
<h3>{{ loop.index }}. {{ a.titulo }}</h3>
<table>
  <tr><th>CN</th><th>Descripción</th><th>Laboratorio</th><th class="n">Uds.</th><th class="n">Importe</th></tr>
  {% for ref in a.references %}
  <tr><td>{{ ref.codigo_nacional }}</td><td>{{ ref.descripcion or "—" }}</td><td>{{ ref.laboratorio or "—" }}</td><td class="n">{{ ref.unidades | num }}</td><td class="n">{{ ref.importe_eur | eur }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endfor %}

{% if r.anexo_acciones %}
<h3>Otras acciones</h3>
<table>
  <tr><th>Acción</th><th class="n">Impacto</th></tr>
  {% for a in r.anexo_acciones %}<tr><td>{{ a.titulo }}</td><td class="n">{{ a.impact_eur | eur }}</td></tr>{% endfor %}
</table>
{% endif %}

<h3>Laboratorios (últimos {{ r.umbrales.meses_laboratorio }} meses)</h3>
<table>
  <tr><th>Laboratorio</th><th class="n">Compras a coste</th><th class="n">Ventas a coste</th><th class="n">Compras/ventas</th><th class="n">Margen</th></tr>
  {% for l in r.laboratorios %}
  <tr><td>{{ l.laboratorio }}{% if l.compra_alta %} ·&nbsp;alto{% endif %}</td><td class="n">{{ l.compras_coste | eur }}</td><td class="n">{{ l.coste_ventas | eur }}</td><td class="n">{{ l.ratio_compras_ventas | num(2) }}</td><td class="n">{{ l.margen_bruto_pct | pct }}</td></tr>
  {% endfor %}
</table>

<h3>Familias (últimos 12 meses)</h3>
<table>
  <tr><th>Familia</th><th class="n">Ventas sin IVA</th><th class="n">Peso</th><th class="n">Margen bruto</th><th class="n">Stock a coste</th></tr>
  {% for f in r.familias %}
  <tr><td>{{ f.nombre }}</td><td class="n">{{ f.ventas_eur | eur }}</td><td class="n">{{ f.peso_ventas_pct | pct }}</td><td class="n">{{ f.margen_bruto_pct | pct }}</td><td class="n">{{ f.valor_stock | eur }}</td></tr>
  {% endfor %}
</table>

<p class="note">Cifras calculadas a partir de las exportaciones del programa de gestión{% if r.programa %} ({{ r.programa }}){% endif %}. {{ r.umbrales.nota }} Sin movimiento: {{ r.umbrales.sin_movimiento_dias }} días · reposición {{ r.umbrales.dias_reposicion | num }} + seguridad {{ r.umbrales.dias_seguridad | num }} días · compras/ventas alto &gt; {{ r.umbrales.ratio_compras_ventas_alto | num(2) }}. {{ r.motor }}.</p>
</section>
</div>
</body>
</html>
