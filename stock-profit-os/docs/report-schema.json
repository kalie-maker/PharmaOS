{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmaos.local/report-schema.json",
  "title": "PharmaOS report.json",
  "description": "Contrato de datos entre el motor (stock-profit-os) y la web. Versión 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generado_por", "farmacia", "resumen", "acciones", "productos", "historico_simulado", "historico_semanas"],
  "properties": {
    "version": { "const": 1 },
    "generado_por": { "type": "string" },
    "farmacia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "fecha_datos", "semana", "programa", "ficticia"],
      "properties": {
        "nombre": { "type": "string", "minLength": 1 },
        "fecha_datos": { "type": "string", "format": "date" },
        "semana": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "programa": { "type": ["string", "null"] },
        "ficticia": { "type": "boolean" }
      }
    },
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capital_inmovilizado_eur", "referencias_inmovilizadas", "stock_total_eur", "recuperable_semana_eur",
                   "acciones_total", "acciones_por_tipo", "importe_por_tipo", "umbral_sin_movimiento_dias"],
      "properties": {
        "capital_inmovilizado_eur": { "type": "number", "minimum": 0 },
        "referencias_inmovilizadas": { "type": "integer", "minimum": 0 },
        "stock_total_eur": { "type": "number", "minimum": 0 },
        "recuperable_semana_eur": { "type": "number", "minimum": 0 },
        "acciones_total": { "type": "integer", "minimum": 0 },
        "acciones_por_tipo": { "$ref": "#/$defs/porTipoEntero" },
        "importe_por_tipo": { "$ref": "#/$defs/porTipoNumero" },
        "umbral_sin_movimiento_dias": { "type": "integer", "minimum": 1 }
      }
    },
    "acciones": { "type": "array", "items": { "$ref": "#/$defs/accion" } },
    "productos": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9A-Z]+$" },
      "additionalProperties": { "$ref": "#/$defs/producto" }
    },
    "historico_simulado": { "type": "boolean" },
    "historico_semanas": { "type": "array", "items": { "$ref": "#/$defs/semana" } }
  },
  "$defs": {
    "tipo": { "enum": ["DEVOLVER", "BAJAR_PEDIDO", "REPONER", "CADUCA_PRONTO"] },
    "porTipoEntero": {
      "type": "object", "additionalProperties": false,
      "required": ["DEVOLVER", "BAJAR_PEDIDO", "REPONER", "CADUCA_PRONTO"],
      "properties": {
        "DEVOLVER": { "type": "integer" }, "BAJAR_PEDIDO": { "type": "integer" },
        "REPONER": { "type": "integer" }, "CADUCA_PRONTO": { "type": "integer" }
      }
    },
    "porTipoNumero": {
      "type": "object", "additionalProperties": false,
      "required": ["DEVOLVER", "BAJAR_PEDIDO", "REPONER", "CADUCA_PRONTO"],
      "properties": {
        "DEVOLVER": { "type": "number" }, "BAJAR_PEDIDO": { "type": "number" },
        "REPONER": { "type": "number" }, "CADUCA_PRONTO": { "type": "number" }
      }
    },
    "paso": {
      "type": "object", "additionalProperties": false, "required": ["concepto", "valor"],
      "properties": { "concepto": { "type": "string" }, "valor": { "type": "string" } }
    },
    "accion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "producto_id", "titulo", "motivo_1_linea", "importe_eur", "cantidad_sugerida",
                   "urgencia", "plazo", "plazo_texto", "calculo_explicado"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+-[0-9A-Z]+$" },
        "tipo": { "$ref": "#/$defs/tipo" },
        "producto_id": { "type": "string" },
        "titulo": { "type": "string", "minLength": 1 },
        "motivo_1_linea": { "type": "string", "minLength": 1 },
        "importe_eur": { "type": "number", "exclusiveMinimum": 0 },
        "cantidad_sugerida": { "type": "integer", "minimum": 0 },
        "urgencia": { "enum": ["alta", "media", "baja"] },
        "plazo": { "enum": ["hoy", "esta_semana", "proximo_pedido", "antes_de"] },
        "plazo_fecha": { "type": "string", "format": "date" },
        "plazo_texto": { "type": "string" },
        "calculo_explicado": {
          "type": "object", "additionalProperties": false, "required": ["pasos", "formula", "resultado"],
          "properties": {
            "pasos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paso" } },
            "formula": { "type": "string" },
            "resultado": { "type": "string" }
          }
        }
      }
    },
    "producto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo", "nombre", "familia", "laboratorio", "stock", "coste", "pvp", "valor_stock",
                   "ventas_semanales_12", "dias_cobertura", "ultima_venta", "caducidad", "abc"],
      "properties": {
        "codigo": { "type": "string" },
        "nombre": { "type": ["string", "null"] },
        "familia": { "type": "string" },
        "laboratorio": { "type": ["string", "null"] },
        "stock": { "type": ["number", "null"] },
        "coste": { "type": ["number", "null"] },
        "pvp": { "type": ["number", "null"] },
        "valor_stock": { "type": ["number", "null"] },
        "ventas_semanales_12": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "integer" } },
        "dias_cobertura": { "type": ["number", "null"] },
        "ultima_venta": { "type": ["string", "null"], "format": "date" },
        "caducidad": { "type": ["string", "null"], "format": "date" },
        "abc": { "enum": ["A", "B", "C"] }
      }
    },
    "semana": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semana", "fecha_inicio", "encontrado_eur", "ejecutado_eur", "recuperado_eur",
                   "acciones_encontradas", "acciones_ejecutadas"],
      "properties": {
        "semana": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "fecha_inicio": { "type": "string", "format": "date" },
        "encontrado_eur": { "type": "number", "minimum": 0 },
        "ejecutado_eur": { "type": "number", "minimum": 0 },
        "recuperado_eur": { "type": "number", "minimum": 0 },
        "acciones_encontradas": { "type": "integer", "minimum": 0 },
        "acciones_ejecutadas": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
